---
import Icon from "./Icon.astro";
import { authors } from "../data/research";
interface Props { paper: { id: string; title: string; date: string; categories: string[]; color: string; keyFinding: string; abstract: string }; index: number; full?: boolean }
const { paper: p, index, full = false } = Astro.props;
---
<article class="card paper" style={`--c:${p.color}`}>
  <div class="badge" aria-hidden="true">P{index}</div>
  <div class="body">
    <p class="kicker">arXiv:{p.id} · {p.date} · {p.categories.join(", ")}</p>
    <h3><a href={`https://arxiv.org/abs/${p.id}`} rel="noopener">{p.title}</a></h3>
    <p class="authors"><strong>Rohit Sharma</strong>{authors.replace("Rohit Sharma", "")}</p>
    <p class="finding"><span>Key finding</span> {p.keyFinding}</p>
    {full && (
      <details>
        <summary>Read the abstract</summary>
        <p>{p.abstract}</p>
      </details>
    )}
    <div class="links">
      <a class="btn btn-ghost small" href={`https://arxiv.org/abs/${p.id}`} rel="noopener">arXiv page <Icon name="external" size={16} /></a>
      <a class="btn btn-ghost small" href={`https://arxiv.org/pdf/${p.id}`} rel="noopener">PDF <Icon name="paper" size={16} /></a>
    </div>
  </div>
</article>

<style>
  .paper { display: grid; grid-template-columns: 64px 1fr; gap: 22px; border-left: 4px solid var(--cl); }
  .badge { width: 64px; height: 64px; border-radius: 18px; display: grid; place-items: center; font-weight: 800; font-size: 1.3rem;
    color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); }
  :global(:root[data-theme="dark"]) .badge { color: var(--cl); background: color-mix(in srgb, var(--cl) 16%, transparent); }
  .kicker { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); margin-bottom: 6px; }
  h3 { font-size: 1.2rem; }
  h3 a { color: var(--accent-strong); text-decoration: none; }
  h3 a:hover { color: var(--teal); }
  .authors { font-size: 0.9rem; color: var(--muted); }
  .finding { background: var(--bg-soft); border-radius: var(--radius-sm); padding: 12px 16px; font-size: 0.95rem; }
  .finding span { font-weight: 800; color: var(--c); margin-right: 6px; }
  :global(:root[data-theme="dark"]) .finding span { color: var(--cl); }
  details { margin: 0 0 14px; }
  summary { cursor: pointer; font-weight: 700; color: var(--accent); }
  details p { margin-top: 10px; color: var(--muted); font-size: 0.95rem; }
  .links { display: flex; gap: 10px; flex-wrap: wrap; }
  .small { padding: 8px 16px; font-size: 0.88rem; }
  @media (max-width: 640px) { .paper { grid-template-columns: 1fr; } }
</style>
