---
import Icon from "./Icon.astro";
import { site } from "../data/profile";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container foot">
    <div>
      <p class="name">{site.name}</p>
      <p class="muted small">{site.role} · {site.org}</p>
    </div>
    <ul class="social">
      {site.socials.map((s) => (
        <li><a href={s.href} aria-label={s.label} rel={s.href.startsWith("http") ? "me noopener" : undefined}><Icon name={s.icon} /></a></li>
      ))}
      <li><a href="/rss.xml" aria-label="Blog RSS feed"><Icon name="rss" /></a></li>
    </ul>
  </div>
  <div class="container legal muted small">© {year} {site.name}.</div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--border); padding: 40px 0 28px; margin-top: 40px; }
  .foot { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .name { font-weight: 800; margin: 0; color: var(--accent-strong); }
  .small { font-size: 0.88rem; margin: 0; }
  .social { display: flex; gap: 8px; list-style: none; padding: 0; margin: 0; }
  .social a {
    width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px;
    border: 1px solid var(--border); color: var(--text); background: var(--surface);
  }
  .social a:hover { border-color: var(--teal); color: var(--teal); }
  .legal { margin-top: 22px; }
</style>
