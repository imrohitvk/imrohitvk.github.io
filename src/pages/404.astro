---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Page not found" description="This page does not exist.">
  <section class="section">
    <div class="container center">
      <p class="code">404</p>
      <h1>This page went off-poll.</h1>
      <p class="lead">The page you were looking for doesn't exist or has moved.</p>
      <div class="cta">
        <a class="btn btn-primary" href="/">Back home <Icon name="arrow" size={18} /></a>
        <a class="btn btn-ghost" href="/projects/">See projects</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .center { text-align: center; display: flex; flex-direction: column; align-items: center; padding: 40px 24px; }
  .code {
    font-size: clamp(5rem, 16vw, 9rem); font-weight: 800; line-height: 1; margin: 0 0 10px; letter-spacing: -0.05em;
    background: linear-gradient(120deg, var(--ocean), var(--teal) 55%, var(--coral)); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 18px; }
</style>
